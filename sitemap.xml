---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sitemap_pages = site.pages | sort: 'url' %}
{% for entry in sitemap_pages %}
  {% assign suffix = entry.url | slice: -5, 5 %}
  {% assign ending = entry.url | slice: -1, 1 %}
  {% if ending == '/' or suffix == '.html' %}
    {% if entry.sitemap != false and entry.published != false and entry.url != '/404.html' %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
      {% if entry.last_modified_at %}<lastmod>{{ entry.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endif %}
  {% endif %}
{% endfor %}
{% for entry in site.posts %}
  {% if entry.sitemap != false and entry.published != false %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
    {% if entry.last_modified_at %}<lastmod>{{ entry.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>